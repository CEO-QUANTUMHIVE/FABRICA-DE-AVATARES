{
  "name": "@quantumhive/fabrica-de-avatares",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "avatar:manifest": "node scripts/build-avatar-manifest.mjs",
    "avatar:upload": "node scripts/upload-avatar-cache.mjs",
