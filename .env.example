# Variables visibles en el navegador. La publishable key es pública por diseño.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
VITE_AVATAR_ASSET_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/avatar-cache/<tenant>/<product>/<avatar>/<version>

# Variables privadas. Nunca usar el prefijo VITE_ en estas claves.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
SUPABASE_DB_PASSWORD=REEMPLAZAR
SUPABASE_DB_URL=postgresql://postgres:<password-url-encoded>@db.<project-ref>.supabase.co:5432/postgres
